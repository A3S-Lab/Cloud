{
  "name": "@a3s/cloud-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "a3s-cloud": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun build --compile --minify --outfile dist/a3s-cloud src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "test": "bun test"
  },
  "dependencies": {
    "@a3s/cloud-client": "file:../packages/cloud-client"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
