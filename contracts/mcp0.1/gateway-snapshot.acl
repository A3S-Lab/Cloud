# Canonical MCP0.1 modern stateless managed-snapshot fixture.
mode { kind = "cloud-managed" }
managed { gateway_id = "11111111-1111-4111-8111-111111111111" }

entrypoints "web" { address = "127.0.0.1:8080" }
routers "mcp" {
  rule = "Host(`mcp.example.com`) && Path(`/mcp`)"
  service = "default-deny"
  entrypoints = ["web"]
}
services "default-deny" {
  load_balancer {
    servers = [{ url = "http://127.0.0.1:9000/" }]
  }
}
services "mcp-target-1" {
  load_balancer {
    request_timeout = "30s"
    stream_idle_timeout = "5m"
    stream_total_timeout = "60m"
    servers = [{ url = "http://127.0.0.1:8000/" }]
  }
}

mcp {
  expires_at = "2099-01-01T00:00:00Z"

  profiles "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" {
    protocol_versions = ["2026-07-28"]
    path = "/mcp"
    request_sse = true
    subscriptions = true
    max_request_bytes = 1048576
    max_response_bytes = 8388608
  }

  credentials "33333333-3333-4333-8333-333333333333" {
    environment_id = "22222222-2222-4222-8222-222222222222"
    audience = "cloud-mcp"
    prefix = "a3s_mcp_abc12345"
    verifier_hash = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQxMjM0NTY3OA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    generation = 7
    expires_at = "2098-12-31T23:00:00Z"
    revoked = false
  }

  routes "44444444-4444-4444-8444-444444444444" {
    router = "mcp"
    environment_id = "22222222-2222-4222-8222-222222222222"
    policy_revision = 11
    profile_digest = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    allowed_origins = ["https://console.example.com"]
    max_header_bytes = 32768
    max_request_bytes = 524288
    max_response_bytes = 4194304
    first_response_timeout = "30s"
    stream_idle_timeout = "2m"
    stream_total_timeout = "30m"
    drain_timeout = "30s"
    telemetry_names = ["weather"]

    targets "55555555-5555-4555-8555-555555555555" {
      node_id = "66666666-6666-4666-8666-666666666666"
      asset_release_id = "77777777-7777-4777-8777-777777777777"
      unit_id = "workload:mcp-weather:replica:1"
      generation = 3
      service = "mcp-target-1"
      endpoint = "http://127.0.0.1:8000/"
      profile_digest = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      priority = 0
      weight = 100
    }

    grants "33333333-3333-4333-8333-333333333333" {
      credential_generation = 7
      methods = ["server/discover", "tools/list", "tools/call"]
      names = ["weather"]
      limits {
        max_concurrent_requests = 8
        requests_per_minute = 120
        request_burst = 16
      }
    }
  }
}
