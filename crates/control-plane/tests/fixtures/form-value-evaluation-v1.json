    {
      "name": "complete-expression-operator-coverage",
      "request": {
        "apiVersion": "a3s.dev/form-core/evaluate-request/v1alpha1",
        "formPlan": {
          "apiVersion": "a3s.dev/form-plan/v1alpha1",
          "schemaProfile": "a3s.dev/form-schema-profile/1",
          "metadata": { "locale": "en-US" },
          "schema": { "type": "object" },
          "nodes": [
            { "id": "arithmetic", "kind": "field", "valuePath": "arithmetic", "depth": 1 },
            { "id": "label", "kind": "field", "valuePath": "label", "depth": 1 },
            { "id": "structural", "kind": "field", "valuePath": "structural", "depth": 1 },
            { "id": "contains", "kind": "field", "valuePath": "contains", "depth": 1 },
            { "id": "membership", "kind": "field", "valuePath": "membership", "depth": 1 },
            { "id": "checks", "kind": "field", "valuePath": "checks", "depth": 1 }
          ],
          "nodeById": {
            "arithmetic": {
              "id": "arithmetic",
              "kind": "field",
              "valuePath": "arithmetic",
              "depth": 1
            },
            "label": { "id": "label", "kind": "field", "valuePath": "label", "depth": 1 },
            "structural": {
              "id": "structural",
              "kind": "field",
              "valuePath": "structural",
              "depth": 1
            },
            "contains": { "id": "contains", "kind": "field", "valuePath": "contains", "depth": 1 },
            "membership": {
              "id": "membership",
              "kind": "field",
              "valuePath": "membership",
              "depth": 1
            },
            "checks": { "id": "checks", "kind": "field", "valuePath": "checks", "depth": 1 }
          },
          "rules": [
            {
              "id": "derive-arithmetic",
              "target": "arithmetic",
              "kind": "computed",
              "expression": {
                "op": "divide",
                "left": {
                  "op": "subtract",
                  "left": {
                    "op": "multiply",
                    "left": {
                      "op": "add",
                      "left": { "op": "field", "path": "left" },
                      "right": { "op": "literal", "value": 2 }
                    },
                    "right": { "op": "literal", "value": 3 }
                  },
                  "right": { "op": "literal", "value": 6 }
                },
                "right": { "op": "literal", "value": 2 }
              }
            },
            {
              "id": "derive-label",
              "target": "label",
              "kind": "computed",
              "expression": {
                "op": "if",
                "condition": {
                  "op": "all",
                  "values": [
                    {
                      "op": "gte",
                      "left": { "op": "field", "path": "age" },
                      "right": { "op": "literal", "value": 18 }
                    },
                    { "op": "not", "value": { "op": "field", "path": "disabled" } }
                  ]
                },
                "whenTrue": {
                  "op": "concat",
                  "values": [
                    { "op": "literal", "value": "role:" },
                    { "op": "field", "path": "role" },
                    { "op": "literal", "value": "/" },
                    {
                      "op": "coalesce",
                      "values": [
                        { "op": "field", "path": "missing" },
                        { "op": "literal", "value": "fallback" }
                      ]
                    }
                  ]
                },
                "whenFalse": { "op": "literal", "value": "disabled" }
              }
            },
            {
              "id": "derive-structural",
              "target": "structural",
              "kind": "computed",
              "expression": {
                "op": "eq",
                "left": { "op": "literal", "value": { "a": 1, "b": 2 } },
                "right": { "op": "literal", "value": { "b": 2, "a": 1 } }
              }
            },
            {
              "id": "derive-contains",
              "target": "contains",
              "kind": "computed",
              "expression": {
                "op": "contains",
                "left": { "op": "literal", "value": [{ "id": 1 }] },
                "right": { "op": "literal", "value": { "id": 1 } }
              }
            },
            {
              "id": "derive-membership",
              "target": "membership",
              "kind": "computed",
              "expression": {
                "op": "in",
                "left": { "op": "field", "path": "role" },
                "right": { "op": "literal", "value": ["member", "admin"] }
              }
            },
            {
              "id": "derive-checks",
              "target": "checks",
              "kind": "computed",
              "expression": {
                "op": "all",
                "values": [
                  {
                    "op": "ne",
                    "left": { "op": "field", "path": "role" },
                    "right": { "op": "literal", "value": "guest" }
                  },
                  {
                    "op": "gt",
                    "left": { "op": "field", "path": "age" },
                    "right": { "op": "literal", "value": 17 }
                  },
                  {
                    "op": "gte",
                    "left": { "op": "field", "path": "age" },
                    "right": { "op": "literal", "value": 18 }
                  },
                  {
                    "op": "lt",
                    "left": { "op": "field", "path": "age" },
                    "right": { "op": "literal", "value": 65 }
                  },
                  {
                    "op": "lte",
                    "left": { "op": "field", "path": "age" },
                    "right": { "op": "literal", "value": 18 }
                  },
                  { "op": "exists", "value": { "op": "field", "path": "role" } },
                  {
                    "op": "any",
                    "values": [
                      { "op": "literal", "value": false },
                      { "op": "field", "path": "enabled" }
                    ]
                  }
                ]
              }
            }
          ],
          "expressionOperationLimit": 256,
          "dependencyOrder": [
            "arithmetic",
            "label",
            "structural",
            "contains",
            "membership",
            "checks"
          ]
        },
        "value": {
          "left": 10,
          "age": 18,
          "disabled": false,
          "role": "admin",
          "enabled": true
        }
      },
      "response": {
        "apiVersion": "a3s.dev/form-core/evaluate-response/v1alpha1",
        "compilerRevision": "a3s-form-core@0.1.0",
        "ok": true,
        "value": {
          "left": 10,
          "age": 18,
          "disabled": false,
          "role": "admin",
          "enabled": true,
          "arithmetic": 15,
          "label": "role:admin/fallback",
          "structural": true,
          "contains": true,
          "membership": true,
          "checks": true
        },
        "trace": [
          {
            "ruleId": "derive-arithmetic",
            "target": "arithmetic",
            "path": "arithmetic",
            "dependencies": ["left"],
            "status": "set"
          },
          {
            "ruleId": "derive-label",
            "target": "label",
            "path": "label",
            "dependencies": ["age", "disabled", "missing", "role"],
            "status": "set"
          },
          {
            "ruleId": "derive-structural",
            "target": "structural",
            "path": "structural",
            "dependencies": [],
            "status": "set"
          },
          {
            "ruleId": "derive-contains",
            "target": "contains",
            "path": "contains",
            "dependencies": [],
            "status": "set"
          },
          {
            "ruleId": "derive-membership",
            "target": "membership",
            "path": "membership",
            "dependencies": ["role"],
            "status": "set"
          },
          {
            "ruleId": "derive-checks",
            "target": "checks",
            "path": "checks",
            "dependencies": ["age", "enabled", "role"],
            "status": "set"
          }
        ],
        "errors": []
      }
    }
