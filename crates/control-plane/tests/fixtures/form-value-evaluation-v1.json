{
  "apiVersion": "a3s.dev/form-value-evaluation-conformance/v1",
  "cases": [
    {
      "name": "computed-value-and-schema-error",
      "request": {
        "apiVersion": "a3s.dev/form-core/evaluate-request/v1alpha1",
        "formPlan": {
          "apiVersion": "a3s.dev/form-plan/v1alpha1",
          "schemaProfile": "a3s.dev/form-schema-profile/1",
          "metadata": { "locale": "en-US" },
          "schema": {
            "type": "object",
            "properties": {
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "total": { "type": "number" }
            },
            "required": ["total"],
            "additionalProperties": false
          },
          "nodes": [{ "id": "total", "kind": "field", "valuePath": "total", "depth": 1 }],
          "nodeById": {
            "total": { "id": "total", "kind": "field", "valuePath": "total", "depth": 1 }
          },
          "rules": [
            {
              "id": "derive-total",
              "target": "total",
              "kind": "computed",
              "expression": {
                "op": "multiply",
                "left": { "op": "field", "path": "quantity" },
                "right": { "op": "field", "path": "unitPrice" }
              }
            }
          ],
          "ruleDependencies": { "derive-total": ["quantity", "unitPrice"] },
          "expressionOperationLimit": 256,
          "dependencyOrder": ["total"]
        },
        "value": { "quantity": 2, "unitPrice": 4, "extra": true },
        "options": { "includeValues": true }
      },
      "response": {
        "apiVersion": "a3s.dev/form-core/evaluate-response/v1alpha1",
        "compilerRevision": "a3s-form-core@0.1.0",
        "ok": false,
        "value": { "quantity": 2, "unitPrice": 4, "extra": true, "total": 8 },
        "trace": [
          {
            "ruleId": "derive-total",
            "target": "total",
            "path": "total",
            "dependencies": ["quantity", "unitPrice"],
            "status": "set",
            "nextValue": 8
          }
        ],
        "errors": [
          {
            "path": "extra",
            "code": "additionalProperties",
            "message": "Additional properties are not allowed."
          }
        ]
      }
    },
    {
      "name": "row-scoped-computation-and-failure-propagation",
      "request": {
        "apiVersion": "a3s.dev/form-core/evaluate-request/v1alpha1",
        "formPlan": {
          "apiVersion": "a3s.dev/form-plan/v1alpha1",
          "schemaProfile": "a3s.dev/form-schema-profile/1",
          "metadata": { "locale": "zh-CN" },
          "schema": {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "quantity": { "type": "number" },
                    "unitPrice": { "type": "number" },
                    "total": { "type": "number" },
                    "display": { "type": "string" }
                  },
                  "required": ["total"],
                  "additionalProperties": false
                }
              }
            }
          },
          "nodes": [
            {
              "id": "line-total",
              "kind": "field",
              "valuePathTemplate": "lines.*.total",
              "depth": 2
            },
            {
              "id": "line-display",
              "kind": "field",
              "valuePathTemplate": "lines.*.display",
              "depth": 2
            }
          ],
          "nodeById": {
            "line-total": {
              "id": "line-total",
              "kind": "field",
              "valuePathTemplate": "lines.*.total",
              "depth": 2
            },
            "line-display": {
              "id": "line-display",
              "kind": "field",
              "valuePathTemplate": "lines.*.display",
              "depth": 2
            }
          },
          "rules": [
            {
              "id": "derive-line-total",
              "target": "line-total",
              "kind": "computed",
              "scope": "row",
              "expression": {
                "op": "multiply",
                "left": { "op": "field", "path": "lines.*.quantity" },
                "right": { "op": "field", "path": "lines.*.unitPrice" }
              }
            },
            {
              "id": "derive-line-display",
              "target": "line-display",
              "kind": "computed",
              "scope": "row",
              "expression": {
                "op": "concat",
                "values": [
                  { "op": "literal", "value": "$" },
                  { "op": "field", "path": "lines.*.total" }
                ]
              }
            }
          ],
          "ruleDependencies": {
            "derive-line-total": ["lines.*.quantity", "lines.*.unitPrice"],
            "derive-line-display": ["lines.*.total"]
          },
          "expressionOperationLimit": 256,
          "dependencyOrder": ["line-total", "line-display"]
        },
        "value": {
          "lines": [
            { "quantity": 2, "unitPrice": 3 },
            { "quantity": "bad", "unitPrice": 4, "total": 99, "display": "stale" }
          ]
        },
        "options": { "includeValues": true }
      },
      "response": {
        "apiVersion": "a3s.dev/form-core/evaluate-response/v1alpha1",
        "compilerRevision": "a3s-form-core@0.1.0",
        "ok": false,
        "value": {
          "lines": [
            { "quantity": 2, "unitPrice": 3, "total": 6, "display": "$6" },
            { "quantity": "bad", "unitPrice": 4 }
          ]
        },
        "trace": [
          {
            "ruleId": "derive-line-total",
            "target": "line-total",
            "path": "lines.0.total",
            "dependencies": ["lines.0.quantity", "lines.0.unitPrice"],
            "status": "set",
            "nextValue": 6
          },
          {
            "ruleId": "derive-line-total",
            "target": "line-total",
            "path": "lines.1.total",
            "dependencies": ["lines.1.quantity", "lines.1.unitPrice"],
            "status": "error",
            "previousValue": 99,
            "error": "TypeError: Expression multiply operands must be finite numbers."
          },
          {
            "ruleId": "derive-line-display",
            "target": "line-display",
            "path": "lines.0.display",
            "dependencies": ["lines.0.total"],
            "status": "set",
            "nextValue": "$6"
          },
          {
            "ruleId": "derive-line-display",
            "target": "line-display",
            "path": "lines.1.display",
            "dependencies": ["lines.1.total"],
            "status": "skipped",
            "previousValue": "stale",
            "error": "Computed rule derive-line-display was skipped because a dependency failed."
          }
        ],
        "errors": [
          {
            "path": "lines.1.total",
            "code": "rule.derive-line-total.evaluation",
            "message": "TypeError: Expression multiply operands must be finite numbers."
          },
          {
            "path": "lines.1.display",
            "code": "rule.derive-line-display.dependency",
            "message": "Computed rule derive-line-display was skipped because a dependency failed."
          },
          {
            "path": "lines.1.total",
            "code": "required",
            "message": "此项为必填项。"
          },
          {
            "path": "lines.1.quantity",
            "code": "type",
            "message": "值类型必须是 number。"
          }
        ]
      }
    },
    {
      "name": "validation-rule-and-locale-override",
      "request": {
        "apiVersion": "a3s.dev/form-core/evaluate-request/v1alpha1",
        "formPlan": {
          "apiVersion": "a3s.dev/form-plan/v1alpha1",
          "schemaProfile": "a3s.dev/form-schema-profile/1",
          "metadata": { "locale": "zh-CN" },
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "age": { "type": "integer" }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "nodes": [
            { "id": "name", "kind": "field", "valuePath": "name", "depth": 1 },
            { "id": "email", "kind": "field", "valuePath": "email", "depth": 1 },
            { "id": "age", "kind": "field", "valuePath": "age", "depth": 1 }
          ],
          "nodeById": {
            "name": { "id": "name", "kind": "field", "valuePath": "name", "depth": 1 },
            "email": { "id": "email", "kind": "field", "valuePath": "email", "depth": 1 },
            "age": { "id": "age", "kind": "field", "valuePath": "age", "depth": 1 }
          },
          "rules": [
            {
              "id": "adult",
              "target": "age",
              "kind": "validate",
              "expression": {
                "op": "gte",
                "left": { "op": "field", "path": "age" },
                "right": { "op": "literal", "value": 21 }
              }
            }
          ],
          "ruleDependencies": { "adult": ["age"] },
          "expressionOperationLimit": 256,
          "dependencyOrder": []
        },
        "value": { "email": "bad", "age": 20 },
        "options": {
          "locale": "en-US",
          "localeCatalog": {
            "apiVersion": "a3s.dev/form-locale-catalog/v1",
            "messages": {
              "validationRequired": "REQ",
              "validationFormat": "FMT {format}",
              "validationRule": "RULE"
            }
          }
        }
      },
      "response": {
        "apiVersion": "a3s.dev/form-core/evaluate-response/v1alpha1",
        "compilerRevision": "a3s-form-core@0.1.0",
        "ok": false,
        "value": { "email": "bad", "age": 20 },
        "trace": [],
        "errors": [
          { "path": "name", "code": "required", "message": "REQ" },
          { "path": "email", "code": "format.email", "message": "FMT email" },
          { "path": "age", "code": "rule.adult", "message": "RULE" }
        ]
      }
    },
