suite "workflow-studio" {
    version = 1

    scenario "core-studio-authoring" {
        name = "Author Runtime policy in the Dify-derived Studio"
        surface = "web"
        timeout_ms = 120000

        navigate "open-studio" {
            url = "http://127.0.0.1:3000"
        }

        viewport "desktop" {
            width = 1440
            height = 900
        }

        wait "workflow-loaded" {
            text = "欢迎使用 A3S Workflow"
        }

        click "open-node-library" {
            target = testid("open-node-library")
        }

        expect "template-node-available" {
            visible = css("[data-testid='add-node-template']")
        }

        expect "runtime-catalog-contract" {
            text = "所有节点都通过 A3S Runtime 契约执行"
        }

        click "add-template" {
            target = testid("add-node-template")
        }

        expect "template-selected" {
            visible = css("[data-testid='node-inspector']")
        }

        fill "rename-template" {
            target = css("[aria-label='显示名称']")
            value = "Runtime 提示词渲染器"
        }

        fill "configure-template" {
            target = css("[aria-label='节点配置 JSON']")
            value = "{\"value\":{\"message\":\"Runtime {{input.name}}\"}}"
        }

        click "apply-template-config" {
            target = css("[data-testid='node-inspector'] .config-section .secondary-button")
        }

        click "open-runtime-settings" {
            target = role("button", "运行环境")
        }

        fill "select-provider" {
            target = css("[aria-label='Runtime 提供方']")
            value = "production"
        }

        fill "select-pool" {
            target = css("[aria-label='Runtime 资源池']")
            value = "cpu"
        }

        select "select-isolation" {
            target = css("[aria-label='Runtime 隔离方式']")
            values = ["sandbox"]
        }

        select "select-network" {
            target = css("[aria-label='Runtime 网络访问']")
            values = ["none"]
        }

        expect "runtime-placement-visible" {
            text = "通过 A3S Runtime 运行"
        }

        click "delete-template" {
            target = css("[data-testid='node-inspector'] .danger-button")
        }

        expect "template-removed" {
            text = "3 个 Runtime 单元"
        }

        click "reopen-node-library" {
            target = testid("open-node-library")
        }

        click "reject-duplicate-start" {
            target = testid("add-node-start")
        }

        expect "duplicate-boundary-message" {
            text = "当前工作流已经有一个开始节点。"
        }

        click "dismiss-message" {
            target = css(".toast")
        }

        click "close-node-library" {
            target = css("[aria-label='关闭节点库']")
        }

        click "open-test-run" {
            target = testid("open-run-panel")
        }

        fill "invalid-run-input" {
            target = testid("run-input")
            value = "{invalid"
        }

        click "reject-invalid-run" {
            target = role("button", "开始运行")
        }

        expect "invalid-json-message" {
            visible = css(".toast.error")
        }
    }

    scenario "runtime-backed-graph" {
        name = "Run the sample graph through A3S Runtime"
        surface = "web"
        timeout_ms = 120000

        navigate "open-studio" {
            url = "http://127.0.0.1:3000"
        }

        viewport "desktop" {
            width = 1440
            height = 900
        }

        wait "workflow-loaded" {
            text = "欢迎使用 A3S Workflow"
        }

        expect "runtime-unit-count" {
            text = "3 个 Runtime 单元"
        }

        click "open-test-run" {
            target = testid("open-run-panel")
        }

        fill "run-input" {
            target = testid("run-input")
            value = "{\"name\":\"A3S E2E\"}"
        }

        click "run-graph" {
            target = role("button", "开始运行")
        }

        wait "runtime-result" {
            text = "你好，A3S E2E！"
        }

        click "open-runtime-tracing" {
            target = role("button", "追踪")
        }

        expect "start-runtime-succeeded" {
            visible = css(".trace-card:nth-child(1) .trace-status.state-succeeded")
        }

        expect "template-runtime-succeeded" {
            visible = css(".trace-card:nth-child(2) .trace-status.state-succeeded")
        }

        expect "output-runtime-succeeded" {
            visible = css(".trace-card:nth-child(3) .trace-status.state-succeeded")
        }

        click "inspect-start-runtime" {
            target = css(".trace-card:first-child")
        }

        click "open-runtime-evidence" {
            target = role("button", "执行证据")
        }

        expect "runtime-evidence-visible" {
            visible = css("[data-testid='runtime-evidence']")
        }

        expect "runtime-provider-visible" {
            text = "local"
        }

        click "return-to-runtime-run" {
            target = css("[aria-label='Runtime 运行记录']")
        }

        viewport "compact" {
            width = 820
            height = 900
        }

        expect "compact-execution-status" {
            visible = css(".trace-card:nth-child(3) .trace-status.state-succeeded")
        }
    }
}
