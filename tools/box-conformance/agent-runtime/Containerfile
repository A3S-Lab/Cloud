FROM ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316

ARG A3S_CLI_VERSION
ARG A3S_CLI_REVISION
ARG A3S_CLI_ARCHIVE_SHA256

LABEL org.opencontainers.image.source="https://github.com/A3S-Lab/CLI" \
      org.opencontainers.image.version="${A3S_CLI_VERSION}" \
      org.opencontainers.image.revision="${A3S_CLI_REVISION}" \
      dev.a3s.cli-archive-sha256="${A3S_CLI_ARCHIVE_SHA256}"

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 a3s \
    && useradd --uid 65532 --gid 65532 --home-dir /workspace --no-create-home \
        --shell /usr/sbin/nologin a3s \
    && install --directory --owner=a3s --group=a3s /app /app/.a3s /workspace /run/secrets

COPY a3s /usr/bin/a3s
COPY --chown=65532:65532 config.acl /app/config.acl
RUN chmod 0755 /usr/bin/a3s \
    && test "$(/usr/bin/a3s --version)" = "a3s ${A3S_CLI_VERSION}"

RUN printf 'A3S Cloud A0.4 Agent Runtime fixture\n' > /workspace/.a3s-release-seed \
    && git -C /workspace init --initial-branch=main \
    && git -C /workspace config user.name 'A3S Cloud Release Fixture' \
    && git -C /workspace config user.email 'release-fixture@a3s.invalid' \
    && git -C /workspace add .a3s-release-seed \
    && GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
       GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
       git -C /workspace commit --message 'Initialize Agent workspace' \
    && chown -R a3s:a3s /workspace

USER 65532:65532

WORKDIR /workspace
ENV A3S_CONFIG_FILE=/app/config.acl \
    A3S_NON_INTERACTIVE=1 \
    A3S_NO_PROGRESS=1
STOPSIGNAL SIGTERM

# The final release manifest is injected as a read-only Runtime Artifact only
# after this image receives its immutable OCI manifest digest.
ENTRYPOINT ["/usr/bin/a3s", "code", "harness", "--manifest", "/app/.a3s/asset.acl"]
